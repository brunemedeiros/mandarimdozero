     "fr": "Est-ce que vous parlez anglais ?",
     "pt-BR": "O senhor (a senhora) fala inglês?",
     "en": null
    },
    {
     "fr": "Parlez-vous anglais ?",
     "pt-BR": "O senhor (a senhora) fala inglês?",
     "en": null
    }
   ]
  }
