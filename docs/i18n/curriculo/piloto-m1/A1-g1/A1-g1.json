   },
   "destino": "nota",
   "texto": {
    "pt-BR": "Você já usou <strong>être</strong> (ser, estar) para dizer a nacionalidade. No singular:<ul><li><strong>je suis</strong>, <strong>tu es</strong>, <strong>il est</strong>, <strong>elle est</strong></li><li><strong>es</strong> e <strong>est</strong> soam igual: \"é\".</li></ul>",
    "en": null
   },
   "exemplos": [
    {
     "fr": "Je suis brésilienne.",
     "pt-BR": "Eu sou brasileira.",
     "en": null
    },
    {
     "fr": "Tu es français ?",
     "pt-BR": "Você é francês?",
     "en": null
    },
    {
     "fr": "Il est français.",
     "pt-BR": "Ele é francês.",
     "en": null
    }
   ],
   "formas": [
    "je suis",
    "tu es",
    "il est"
   ]
  },
  {
   "id": "etre-plural",
   "id_mapa": null,
