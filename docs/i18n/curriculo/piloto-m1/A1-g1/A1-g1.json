   },
   "destino": "nota",
   "texto": {
    "pt-BR": "No plural:<ul><li><strong>nous sommes</strong>, <strong>vous êtes</strong>, <strong>ils sont</strong>, <strong>elles sont</strong></li><li><strong>ils</strong> é \"eles\" (homens ou grupo misto); <strong>elles</strong> é \"elas\", só mulheres.</li><li>Em <strong>vous‿êtes</strong>, o <strong>s</strong> de <strong>vous</strong> soa como <b>z</b>.</li></ul>",
    "en": null
   },
   "exemplos": [
    {
     "fr": "Nous sommes de Rio.",
     "pt-BR": "Nós somos do Rio.",
     "en": null
    },
    {
     "fr": "Vous êtes de Lyon ?",
     "pt-BR": "Vocês são de Lyon?",
     "en": null
    },
    {
     "fr": "Ils sont de Recife.",
     "pt-BR": "Eles são de Recife.",
     "en": null
    }
   ],
   "formas": [
    "nous sommes",
    "vous êtes",
    "ils sont"
   ]
  },
  {
   "id": "avoir-singular",
